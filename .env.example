# where links in emails point to
KINETIQ_APP_URL=http://localhost:5173

# Resend API key, re_...; empty keeps every mail in the log instead of sending it
MAIL_API_KEY=
# sender address, required once MAIL_API_KEY is set
MAIL_FROM=no-reply@kinetiq.page

# OpenRouter API key, sk-or-v1-...; empty stores every quiz submit as a failed draft
OPENROUTER_API_KEY=
# the free pool is for development; production sets a paid model
OPENROUTER_MODEL=openrouter/free
