# Names of the environment variables the backend reads. This file holds no values.
# The backend does not read a .env file by itself: set these in your shell or in the IDE run configuration.
# Never commit a value.

# OpenRouter key (https://openrouter.ai). Without it Kinetiq starts and drafts plans from a fixed template.
OPENROUTER_API_KEY=

# Model used for drafting. Optional; the default is OpenRouter's router over its free models.
# KINETIQ_LLM_MODEL=openrouter/free
